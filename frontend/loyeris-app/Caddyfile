{$APP_SITE_ADDRESS:http://localhost} {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	@api path /api/*
	handle @api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv

		route {
			try_files {path} /index.html

			@index path /index.html
			header @index Cache-Control "no-cache, no-store, must-revalidate"

			@hashedAssets path_regexp hashedAssets -[A-Za-z0-9_-]{8,}\.(?:css|js)$
			header @hashedAssets Cache-Control "public, max-age=31536000, immutable"

			file_server
		}
	}
}
